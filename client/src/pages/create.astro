---
import Layout from '../layouts/Layout.astro';
import CreatePokemon from '../components/CreatePokemon';
import { fetchSsrJson, resolveApiBase } from '../lib/ssrApi';

const apiBase = resolveApiBase();
let types: any[] = [];
let error: string | null = null;

console.log(`[SSR create.astro] Resolved apiBase to: "${apiBase}"`);
const res = await fetchSsrJson<any[]>(`${apiBase}/types`, {
  ttlSeconds: 3600,
  logTag: 'SSR create.astro',
});
if (res.ok && Array.isArray(res.data)) {
  types = res.data;
} else {
  error = res.status
    ? `Error al obtener tipos de Pokémon (status ${res.status})`
    : res.errorMessage || 'Error al obtener tipos de Pokémon';
}
---

<Layout title="Crear Pokémon">
  <div style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="text-align: center; margin-bottom: 2rem; color: var(--maincolor);">Crea tu propio Pokémon</h1>

    {error && (
      <div class="error-banner">
        <span>{error}</span>
      </div>
    )}

    <CreatePokemon client:load types={types} />
  </div>
</Layout>

<style>
  .error-banner {
    background-color: #ffdddd;
    color: #ff0000;
    padding: 1rem;
    border-radius: 0.25rem;
    margin-bottom: 1.5rem;
    font-weight: bold;
    text-align: center;
  }
</style>
