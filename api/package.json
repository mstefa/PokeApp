{
  "name": "pokemon-api",
  "version": "1.1.0",
  "description": "PokeApp Backend API with Hexagonal Architecture",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration && cucumber-js -p backend",
    "lint": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\""
  },
  "author": "Henry",
  "license": "ISC",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http-status": "2.1.0",
    "morgan": "1.12.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sequelize": "6.37.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/eslintrc": "3.3.6",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "26.4.0",
    "@types/pino": "7.0.5",
    "@types/sequelize": "6.12.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
