{
  "name": "pokemon-api",
  "version": "1.1.0",
  "description": "PokeApp Backend API with Hexagonal Architecture",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration && cucumber-js -p backend",
    "lint": "eslint src/ --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\""
  },
  "author": "Henry",
  "license": "ISC",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status": "^1.7.4",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.35.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.2",
    "@types/pino": "^7.0.4",
    "@types/sequelize": "^6.12.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
